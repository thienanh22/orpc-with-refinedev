                          "id": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991,
                            "exclusiveMinimum": 0
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "climate": {
                            "enum": [
                              "temperate",
                              "arid",
                              "frozen",
                              "gas",
                              "unknown"
                            ],
                            "type": "string"
                          },
                          "discoveredYear": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
