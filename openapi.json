{
  "info": {
    "title": "oRPC Planet API",
    "version": "1.0.0",
    "description": "POC demonstrating versioned, cacheable, REST-mapped oRPC procedures."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "local"
    }
