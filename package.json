{
  "name": "orpc-experiment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "POC for oRPC: versioning, caching, OpenAPI spec, client generation",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "gen:openapi": "tsx src/generate-openapi.ts",
    "client": "tsx src/client.ts"
  },
  "dependencies": {
    "@orpc/client": "^1.14.4",
    "@orpc/contract": "^1.14.4",
    "@orpc/openapi": "^1.14.4",
    "@orpc/openapi-client": "^1.14.4",
    "@orpc/server": "^1.14.4",
    "@orpc/zod": "^1.14.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
